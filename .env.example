# TEG CRM API local environment. Copy to .env and fill in. .env is git-ignored.
# On Vercel these come from the Neon integration (DATABASE_URL, DATABASE_URL_UNPOOLED)
# and Project Settings > Environment Variables (APP_ENV).

# local | preview | production  (production hides /api/v1/docs)
APP_ENV=local

# Pooled (PgBouncer) URL - used by the API at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct URL (same host without "-pooler") - used by Alembic migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Not stored in any file. Set only for a from-scratch seed run (see README):
#   $env:SEED_ADMIN_PASSWORD = '...'
